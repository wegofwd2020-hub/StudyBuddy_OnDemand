# Python
__pycache__/
*.py[cod]
*.pyo
.env
*.egg-info/
dist/
build/
.venv/
venv/

# Secrets — never commit real env files
.env
.env.*
!.env.example
secrets.json

# Database
*.db
*.sqlite

# Content Store (generated — not committed)
content_store/

# Logs
logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Mobile build artefacts
.buildozer/
bin/

# AI-generated lesson content (bind-mounted into containers; grows large, not for git)
content_store_data/

# Local dev config (contains Redis dev credentials + local paths)
.mcp.json

# Pipeline build logs
data/*.log
data/*.log.*

# Scratch / working dirs (never commit)
TRASH/
TRASH-FILES.md
backups/
ux_test_data/
.claire/
.claude/worktrees/

# Node / Bun deps for Remotion projects under sample_content/
node_modules/

# Remotion rendered output (always lands in ~/Downloads first; never commit MP4s)
sample_content/**/*.mp4
sample_content/**/.remotion/
