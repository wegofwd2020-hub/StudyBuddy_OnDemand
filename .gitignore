.env
.env.*
!.env.example
secrets.json

# Database
*.db
*.sqlite

# Content Store (generated — not committed)
content_store/

# Logs
logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Mobile build artefacts
.buildozer/
bin/

# AI-generated lesson content (bind-mounted into containers; grows large, not for git)
content_store_data/
# ...and as a SYMLINK. On the demo VPS `content_store_data` points at
# /data/content, and a trailing-slash pattern matches directories only, so the
# link itself showed as untracked forever.
content_store_data

# Local dev config (contains Redis dev credentials + local paths)
.mcp.json

# Pipeline build logs
data/*.log
data/*.log.*

# Scratch / working dirs (never commit)
TRASH/
TRASH-FILES.md
backups/
ux_test_data/
.claire/
.claude/worktrees/

# Node / Bun deps for Remotion projects under sample_content/
node_modules/

# Remotion rendered output (always lands in ~/Downloads first; never commit MP4s)
sample_content/**/*.mp4
sample_content/**/.remotion/

# Visual assets — the legacy /sample-visuals/ tree was migrated to
# /visuals/_legacy/ under content_store_data/ (issue #318 phase 2d). The
# working-tree copy remains for backward-compat during the transition but
# is no longer tracked.
web/public/sample-visuals/
# Future school-uploaded visuals also land under web/public/visuals/ if
# the dev backend is configured to write there directly; gitignored so
# uploads don't land in commits.
web/public/visuals/

# Agent orchestration: keep workflow state (manifest + ledger) for the
# PROGRESS.md "in flight" section, but ignore the regenerated task briefs.
.orchestration/task-*.md
!.orchestration/manifest.json
!.orchestration/.orchestration.json

# Obsidian editor cruft + accidental scratch (not project content)
.obsidian/
docs/Untitled.base
sample_data_file.txt

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/

# Quiz-suite live fixture handoff file (regenerated by quiz_suite.seed; never committed)
backend/quiz_suite/.fixture.json
web/tests/e2e/quiz-suite/.fixture.json

# Playwright MCP console logs (tool output, written at repo root; the browser
# tier's own artefacts are ignored in web/.gitignore)
.playwright-mcp/

# ── Deployment-host artifacts (keep the VPS working tree clean) ───────────────
#
# A dirty tree on the demo VPS is not cosmetic: `git pull` ABORTS rather than
# overwrite an untracked file, so a deploy fails the moment a commit adds a path
# that already exists there untracked. That happened on 2026-08-31 with
# scripts/demo/disk-check.sh and has root-caused a deploy failure before.
#
# Runtime copies of the curriculum source JSON. The tracked originals live in
# `data/` at the repo root; these are the copies the containers are given, and
# they are regenerated rather than edited. Narrow on purpose —
# `backend/data/help_chunks.jsonl` IS tracked, so ignoring `backend/data/`
# wholesale would hide a real file.
backend/data/grade*.json

# pgbouncer's auth file: usernames plus password hashes, generated per host.
# It has correctly never been committed; this makes sure a `git add -A` on the
# VPS cannot change that.
infra/pgbouncer/userlist.txt
