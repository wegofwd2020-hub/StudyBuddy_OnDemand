# Python
__pycache__/
*.py[cod]
*.pyo
.env
*.egg-info/
dist/
build/
.venv/
venv/

# Secrets — never commit real env files
.env
.env.*
!.env.example
secrets.json

# Database
*.db
*.sqlite

# Content Store (generated — not committed)
content_store/

# Logs
logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Mobile build artefacts
.buildozer/
bin/

# AI-generated lesson content (bind-mounted into containers; grows large, not for git)
content_store_data/

# Local dev config (contains Redis dev credentials + local paths)
.mcp.json

# Pipeline build logs
data/*.log
data/*.log.*

# Scratch / working dirs (never commit)
TRASH/
TRASH-FILES.md
backups/
ux_test_data/
.claire/
.claude/worktrees/

# Node / Bun deps for Remotion projects under sample_content/
node_modules/

# Remotion rendered output (always lands in ~/Downloads first; never commit MP4s)
sample_content/**/*.mp4
sample_content/**/.remotion/

# Visual assets — the legacy /sample-visuals/ tree was migrated to
# /visuals/_legacy/ under content_store_data/ (issue #318 phase 2d). The
# working-tree copy remains for backward-compat during the transition but
# is no longer tracked.
web/public/sample-visuals/
# Future school-uploaded visuals also land under web/public/visuals/ if
# the dev backend is configured to write there directly; gitignored so
# uploads don't land in commits.
web/public/visuals/

# Agent orchestration: keep workflow state (manifest + ledger) for the
# PROGRESS.md "in flight" section, but ignore the regenerated task briefs.
.orchestration/task-*.md
!.orchestration/manifest.json
!.orchestration/.orchestration.json

# Obsidian editor cruft + accidental scratch (not project content)
.obsidian/
docs/Untitled.base
sample_data_file.txt
