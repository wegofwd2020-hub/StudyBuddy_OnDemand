# =============================================================================
# Mambakkam demo server — environment template
# On Hetzner: cp deploy/mambakkam/env.template /opt/studybuddy/.env.demo
# Fill in all values before starting the stack.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=FILL_IN
POSTGRES_DB=studybuddy

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=FILL_IN

# ── JWT secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=FILL_IN
ADMIN_JWT_SECRET=FILL_IN
TEACHER_JWT_SECRET=FILL_IN

# ── Content store ─────────────────────────────────────────────────────────────
CONTENT_STORE_PATH=/data/content

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=FILL_IN
STRIPE_WEBHOOK_SECRET=FILL_IN

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=FILL_IN
AUTH0_CLIENT_ID=FILL_IN
AUTH0_CLIENT_SECRET=FILL_IN
AUTH0_SECRET=FILL_IN
AUTH0_MGMT_CLIENT_ID=FILL_IN
AUTH0_MGMT_CLIENT_SECRET=FILL_IN

# ── GHCR image tag ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BUILD_ID=dev
