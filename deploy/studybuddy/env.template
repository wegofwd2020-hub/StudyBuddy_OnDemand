# =============================================================================
# StudyBuddy server (77.42.13.139) — environment template
# Copy to /opt/studybuddy/.env.demo on the server and fill in all values.
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=FILL_IN_STRONG_PASSWORD
POSTGRES_DB=studybuddy

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=FILL_IN_STRONG_PASSWORD

# ── JWT secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=FILL_IN_STRONG_SECRET
ADMIN_JWT_SECRET=FILL_IN_STRONG_SECRET
TEACHER_JWT_SECRET=FILL_IN_STRONG_SECRET

# ── Content store ─────────────────────────────────────────────────────────────
CONTENT_STORE_PATH=/data/content

# ── Auth0 (use dev placeholders for non-production) ───────────────────────────
AUTH0_DOMAIN=localhost
AUTH0_JWKS_URL=http://localhost/.well-known/jwks.json
AUTH0_STUDENT_CLIENT_ID=dev-student
AUTH0_TEACHER_CLIENT_ID=dev-teacher
AUTH0_CLIENT_ID=dev-client
AUTH0_CLIENT_SECRET=dev-secret
AUTH0_SECRET=FILL_IN_STRONG_SECRET
AUTH0_MGMT_CLIENT_ID=dev-mgmt
AUTH0_MGMT_API_URL=http://localhost/api/v2/

# ── Anthropic (pipeline only — not needed for API server) ─────────────────────
ANTHROPIC_API_KEY=FILL_IN_IF_RUNNING_PIPELINE

# ── Stripe (leave blank if not accepting payments) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Build ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BUILD_ID=FILL_IN_GIT_SHA
