# =============================================================================
# Vaganam local dev — environment template
# Copy to project root: cp deploy/vaganam/env.template .env
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=studybuddy_dev
POSTGRES_DB=studybuddy

# ── PgBouncer ─────────────────────────────────────────────────────────────────
PGBOUNCER_USER=pgbouncer
PGBOUNCER_PASSWORD=studybuddy_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=studybuddy_dev

# ── JWT secrets (dev-only — never use in prod) ────────────────────────────────
JWT_SECRET=dev_jwt_secret_vaganam_change_for_prod
ADMIN_JWT_SECRET=dev_admin_jwt_secret_vaganam_change_for_prod
TEACHER_JWT_SECRET=dev_teacher_jwt_secret_vaganam_change_for_prod

# ── Content store ─────────────────────────────────────────────────────────────
CONTENT_STORE_PATH=/data/content

# ── Pipeline (optional — only needed if running build_grade.py locally) ───────
ANTHROPIC_API_KEY=
TTS_API_KEY=

# ── Stripe (optional — leave blank to skip payment flows) ────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Auth0 (optional — local auth works without these) ────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
